// Generated by scripts/chains.py from chains/skills.dot (team:ui). Do not edit.
// match-ui-to-reference -> audit-agent-diff. Landing (push, PR) stays outside the run: see land-change.
digraph ui {
  graph [description="Converge a UI on a design reference through numbered deltas and visual proof. Worker follows match-ui-to-reference; reviewed with audit-agent-diff.", max_visits=3, handoff_tokens=150000]
  planner      [agent="planner"]
  orchestrator [agent="orchestrator"]
  worker       [agent="worker", count="$pairs", label="match-ui-to-reference", skill="match-ui-to-reference", prompt="Follow the match-ui-to-reference skill (worker). If it is not installed, read skills/match-ui-to-reference/SKILL.md in bcmyguest/personal-skills."]
  "reviewer" [agent="reviewer", count="$pairs", label="audit-agent-diff", skill="audit-agent-diff", prompt="Follow the audit-agent-diff skill (reviewer). If it is not installed, read skills/audit-agent-diff/SKILL.md in bcmyguest/personal-skills."]
  orchestrator -> worker [on=dispatch, kind=broadcast]
  worker -> "reviewer" [on=submit, kind=pair]
  "reviewer" -> worker [on=fail, kind=pair]
  "reviewer" -> orchestrator [on=pass, kind=fan-in]
  worker -> orchestrator [on=blocked, kind=fan-in]
}
