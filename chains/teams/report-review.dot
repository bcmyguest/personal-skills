// Generated by scripts/chains.py from chains/skills.dot (team:report-review). Do not edit.
// write-evidence-report -> independent-review. Landing (push, PR) stays outside the run: see land-change.
digraph report_review {
  graph [description="Publish results or capability claims that say exactly what the evidence supports. Worker follows write-evidence-report; reviewed with independent-review.", max_visits=3, handoff_tokens=150000]
  planner      [agent="planner"]
  orchestrator [agent="orchestrator"]
  worker       [agent="worker", count="$pairs", label="write-evidence-report", skill="write-evidence-report", prompt="Follow the write-evidence-report skill (worker). If it is not installed, read skills/write-evidence-report/SKILL.md in bcmyguest/personal-skills."]
  "reviewer" [agent="reviewer", count="$pairs", label="independent-review", skill="independent-review", prompt="Follow the independent-review skill (reviewer). If it is not installed, read skills/independent-review/SKILL.md in bcmyguest/personal-skills."]
  orchestrator -> worker [on=dispatch, kind=broadcast]
  worker -> "reviewer" [on=submit, kind=pair]
  "reviewer" -> worker [on=fail, kind=pair]
  "reviewer" -> orchestrator [on=pass, kind=fan-in]
  worker -> orchestrator [on=blocked, kind=fan-in]
}
