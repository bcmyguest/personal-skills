// Generated by scripts/chains.py from chains/skills.dot (team:fix-defect). Do not edit.
// diagnose-failure -> audit-agent-diff. Landing (push, PR) stays outside the run: see land-change.
digraph fix_defect {
  graph [description="Find the actual cause of a failure in a running system and fix that cause, not a symptom. Worker follows diagnose-failure; reviewed with audit-agent-diff.", max_visits=3, handoff_tokens=150000]
  planner      [agent="planner"]
  orchestrator [agent="orchestrator"]
  worker       [agent="worker", count="$pairs", label="diagnose-failure", skill="diagnose-failure", prompt="Follow the diagnose-failure skill (worker). If it is not installed, read skills/diagnose-failure/SKILL.md in bcmyguest/personal-skills."]
  "reviewer" [agent="reviewer", count="$pairs", label="audit-agent-diff", skill="audit-agent-diff", prompt="Follow the audit-agent-diff skill (reviewer). If it is not installed, read skills/audit-agent-diff/SKILL.md in bcmyguest/personal-skills."]
  orchestrator -> worker [on=dispatch, kind=broadcast]
  worker -> "reviewer" [on=submit, kind=pair]
  "reviewer" -> worker [on=fail, kind=pair]
  "reviewer" -> orchestrator [on=pass, kind=fan-in]
  worker -> orchestrator [on=blocked, kind=fan-in]
}
