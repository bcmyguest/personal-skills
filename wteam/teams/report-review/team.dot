// report-review: one write-evidence-report step, reviewed with independent-review. Landing (push, PR) stays outside the run: see land-change.
digraph report_review {
  graph [description="Publish results or capability claims that say exactly what the evidence supports. Worker follows write-evidence-report; reviewed with independent-review.", max_visits=3, handoff_tokens=150000]
  planner      [agent="planner"]
  orchestrator [agent="orchestrator"]
  worker       [agent="worker", count="$pairs", skill="write-evidence-report", prompt="If the write-evidence-report skill is not installed, read skills/write-evidence-report/SKILL.md in bcmyguest/personal-skills."]
  reviewer     [agent="reviewer", count="$pairs", skill="independent-review", prompt="If the independent-review skill is not installed, read skills/independent-review/SKILL.md in bcmyguest/personal-skills."]
  orchestrator -> worker   [on=dispatch, kind=broadcast]
  worker -> reviewer       [on=submit, kind=pair]
  reviewer -> worker       [on=fail, kind=pair]
  reviewer -> orchestrator [on=pass, kind=fan-in]
  worker -> orchestrator   [on=blocked, kind=fan-in]
}
