// decide-and-build: research the options, then settle the decisions with the user. The decide
// step asks its round by blocking; the user answers with `wteam requeue <id> --note "1a 2c"`,
// which returns the ticket to the same step. Stops at the decision record: to-spec,
// to-tickets and the build run outside this team.
digraph decide_and_build {
  graph [description="Research the options for a costly-to-reverse choice, then settle it with the user and record the decision. Steps: research-options (reviewed with independent-review), resolve-design-decisions (reviewed with independent-review). Stops at the decision record.", max_visits=3, handoff_tokens=150000]
  planner         [agent="planner"]
  orchestrator    [agent="orchestrator"]
  research        [agent="worker", count="$pairs", skill="research-options", prompt="If the research-options skill is not installed, read skills/research-options/SKILL.md in bcmyguest/personal-skills."]
  research_review [agent="reviewer", count="$pairs", skill="independent-review", prompt="If the independent-review skill is not installed, read skills/independent-review/SKILL.md in bcmyguest/personal-skills."]
  decide          [agent="worker", count="$pairs", skill="resolve-design-decisions", prompt="You cannot talk to the user directly. Write each round of questions to the ticket's decision record, then run `wteam block <ticket> --reason \"decisions needed: <path>\"`. The user's answers arrive in the next brief as a requeue note. Submit once every decision is recorded. If the resolve-design-decisions skill is not installed, read skills/resolve-design-decisions/SKILL.md in bcmyguest/personal-skills."]
  decide_review   [agent="reviewer", count="$pairs", skill="independent-review", prompt="If the independent-review skill is not installed, read skills/independent-review/SKILL.md in bcmyguest/personal-skills."]

  orchestrator -> research         [on=dispatch, kind=broadcast]
  research -> research_review      [on=submit, kind=pair]
  research_review -> research      [on=fail, kind=pair]
  research_review -> decide        [on=pass, kind=pair]
  decide -> decide_review          [on=submit, kind=pair]
  decide_review -> decide          [on=fail, kind=pair]
  decide_review -> orchestrator    [on=pass, kind=fan-in]
  research -> orchestrator         [on=blocked, kind=fan-in]
  decide -> orchestrator           [on=blocked, kind=fan-in]
}
