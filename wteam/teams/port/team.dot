// port: one port-changes step, reviewed with audit-agent-diff. Landing (push, PR) stays outside the run: see land-change.
digraph port {
  graph [description="Bring selected work from another branch, PR, archive, or older architecture into the current line without dragging unwanted changes along. Worker follows port-changes; reviewed with audit-agent-diff.", max_visits=3, handoff_tokens=150000]
  planner      [agent="planner"]
  orchestrator [agent="orchestrator"]
  worker       [agent="worker", count="$pairs", skill="port-changes", prompt="If the port-changes skill is not installed, read skills/port-changes/SKILL.md in bcmyguest/personal-skills."]
  reviewer     [agent="reviewer", count="$pairs", skill="audit-agent-diff", prompt="If the audit-agent-diff skill is not installed, read skills/audit-agent-diff/SKILL.md in bcmyguest/personal-skills."]
  orchestrator -> worker   [on=dispatch, kind=broadcast]
  worker -> reviewer       [on=submit, kind=pair]
  reviewer -> worker       [on=fail, kind=pair]
  reviewer -> orchestrator [on=pass, kind=fan-in]
  worker -> orchestrator   [on=blocked, kind=fan-in]
}
